# Generic OpenAI-compatible model configuration.
# Chat LLM: DeepSeek (OpenAI-compatible). Use deepseek-chat, NOT deepseek-reasoner
# (reasoner's thinking output slows down interactive booking flows).
MODEL_PROVIDER=deepseek
LLM_API_KEY=your_deepseek_api_key_here
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# Embeddings: local Ollama + bge-m3 (1024-dim, strong Chinese semantics, zero cost).
# Requires: ollama installed and running, `ollama pull bge-m3` done once.
# Fallback to any OpenAI-compatible embedding API by switching EMBEDDING_PROVIDER/base_url/model.
EMBEDDING_PROVIDER=ollama
EMBEDDING_API_KEY=ollama
EMBEDDING_BASE_URL=http://localhost:11434/v1
EMBEDDING_MODEL=bge-m3

# Weather tool uses Open-Meteo (free geocoding + forecast APIs), no API key required.

# Optional Azure OpenAI mode:
# If you set MODEL_PROVIDER=azure or EMBEDDING_PROVIDER=azure, also add the required AZURE_OPENAI_* values.
